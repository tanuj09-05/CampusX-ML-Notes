												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "thoda-thoda (incremental)"
												},
												{
													"type": "text",
													"text": " data aate hi update hota rehta hai."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
