											},
											"content": [
												{
													"type": "text",
													"text": "Kam features hone ki wajah se machine learning algorithms ko kam computation karni padti hai."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
